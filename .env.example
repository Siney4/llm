# === Required ===

# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# At least ONE provider key must be set.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEVIN_API_KEY=

# === Provider models / modes ===

# Comma-separated list of model IDs exposed to users, per provider.
# The first one is the default.
#   OPENAI_MODELS=gpt-5,gpt-5-mini,gpt-4.1,o4-mini
#   ANTHROPIC_MODELS=claude-opus-4-5,claude-sonnet-4-5,claude-haiku-4-5
OPENAI_MODELS=gpt-4o,gpt-4o-mini
ANTHROPIC_MODELS=claude-3-5-sonnet-latest,claude-3-5-haiku-latest

# Devin has NO model selection in the public API (web-UI-only).
# This list is cosmetic — whatever labels you want the user to see.
# The actual underlying LLM is whatever the Devin org is configured to use.
DEVIN_MODELS=Agent,Fast Mode

# === Devin-specific tuning ===

DEVIN_BASE_URL=https://api.devin.ai
DEVIN_POLL_INTERVAL=3.0
# Hard cap on Action Compute Units per session (~$2.25/ACU). Keep low for testing.
# Set to 0 / none / empty to disable the cap (NOT recommended — can get very expensive).
DEVIN_MAX_ACU_LIMIT=1

# === General ===

# Default provider when a new user starts. One of: openai, anthropic, devin
DEFAULT_PROVIDER=openai

# System prompt used for every conversation (ignored by Devin provider).
SYSTEM_PROMPT=You are a helpful, concise assistant. Answer in the user's language.

MAX_HISTORY_MESSAGES=30
MAX_OUTPUT_TOKENS=2048

DB_PATH=data/bot.db

# Comma-separated Telegram user IDs allowed to use the bot. Empty = public.
ALLOWED_USER_IDS=

# Comma-separated Telegram user IDs with admin rights (/stats). Empty = none.
ADMIN_USER_IDS=

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
