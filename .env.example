# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# OpenAI-compatible LLM endpoint.
# Works with any of:
#   - llama.cpp:  llama-server -m Qwen2.5-14B-Instruct-Q4_K_M.gguf -c 8192  (default port 8080)
#   - Ollama:     ollama serve  (use http://localhost:11434/v1, pull qwen2.5:14b-instruct-q4_K_M)
#   - vLLM, LM Studio, text-generation-webui — any OpenAI-compatible /v1 endpoint
OPENAI_BASE_URL=http://localhost:8080/v1
OPENAI_API_KEY=sk-no-key-required
OPENAI_MODEL=Qwen2.5-14B-Instruct-Q4_K_M

# Generation params
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=900
LLM_TIMEOUT_S=120

# Buffer for "treats" as a fraction of TDEE (80/20 rule). 0.15 = 15%.
BUFFER_FRACTION=0.15

# SQLite path for user profiles
DB_PATH=data/nutrition.db

# Optional access control (comma-separated Telegram user IDs). Empty = open to all.
ALLOWED_USER_IDS=

LOG_LEVEL=INFO
