# === Required ===

# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# At least one provider key must be set.
# Both can be empty if you only want to test scaffolding.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# === Optional ===

# Comma-separated list of model IDs exposed to users, per provider.
# Put the provider's real model IDs here; the first one is the default.
# Examples (change as new models release):
#   OPENAI_MODELS=gpt-5,gpt-5-mini,gpt-4.1,o4-mini
#   ANTHROPIC_MODELS=claude-opus-4-5,claude-sonnet-4-5,claude-haiku-4-5
OPENAI_MODELS=gpt-4o,gpt-4o-mini
ANTHROPIC_MODELS=claude-3-5-sonnet-latest,claude-3-5-haiku-latest

# Default provider when a new user starts. One of: openai, anthropic
DEFAULT_PROVIDER=openai

# System prompt used for every conversation (can be overridden per-user later).
SYSTEM_PROMPT=You are a helpful, concise assistant. Answer in the user's language.

# Maximum number of messages (user+assistant combined) kept in conversation history.
MAX_HISTORY_MESSAGES=30

# Maximum tokens to request from the LLM per reply.
MAX_OUTPUT_TOKENS=2048

# Path to SQLite DB file.
DB_PATH=data/bot.db

# Comma-separated Telegram user IDs allowed to use the bot. Empty = public.
ALLOWED_USER_IDS=

# Comma-separated Telegram user IDs with admin rights (e.g. /stats). Empty = none.
ADMIN_USER_IDS=

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
